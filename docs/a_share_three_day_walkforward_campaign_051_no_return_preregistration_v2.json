  "candidate": {
    "name": "intraday_close_range_occupancy_entropy_10b",
    "direction": "higher",
    "formula": "Across the 240 selected closes, let x_i=log(close_i), x_min=min(x), x_max=max(x), and z_i=(x_i-x_min)/(x_max-x_min). Assign b_i=min(floor(10*z_i),9), let p_j=count(b_i=j)/240 for j=0..9, and return -sum_{j:p_j>0}(p_j*log(p_j))/log(10).",
    "economic_hypothesis": "Broad occupation of the completed-session relative close-price range is consistent with distributed two-sided price discovery rather than a fleeting excursion or terminal congestion, potentially leaving a more resilient close-known state for the next-open-to-third-close horizon.",
    "source_projection": ["datetime", "symbol", "provider", "close"],
    "forbidden_source_columns": ["open", "high", "low", "volume", "amount"],
    "selected_bar_count": 240,
    "bin_count": 10,
    "selected_grid": ["09:31-11:30", "13:01-15:00"],
    "include_0930": false,
    "include_lunch_transition": false,
    "order_invariant": true,
    "close_semantics": "Every selected close must be finite and strictly positive; compute normalized location only after the natural-log transform; exact repeated closes remain repeated observations.",
    "range_rule": "The full selected-session natural-log close range must be finite and strictly positive.",
    "bin_rule": "Use ten equal-width bins over [0,1]; bins 0 through 8 are left-closed/right-open and the exact global maximum is assigned to bin 9.",
    "probability_rule": "p_j is the exact count in bin j divided by the fixed denominator 240; empty bins contribute zero.",
    "entropy_rule": "Natural-log Shannon entropy over ten fixed bins divided by log(10).",
    "endpoint_canonicalization_tolerance": 1e-12,
    "valid_range": {"lower": 0.0, "lower_inclusive": true, "upper": 1.0, "upper_inclusive": true},
    "missing_rule": "Any duplicate, missing, or off-grid row; nonfinite or nonpositive close; nonfinite or nonpositive log-close range; normalized coordinate outside [0,1] beyond 1e-12; invalid bin; nonfinite probability or entropy; or score outside [0,1] beyond 1e-12 makes the stock-day missing. Never fill, clip, winsorize, repair, or substitute.",
