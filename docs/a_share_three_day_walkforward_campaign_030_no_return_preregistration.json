      "minimum_leave_one_out_peers_per_return_position": 50,
      "correlation_estimator": "population_pearson_equal_position_weight_separately_by_half",
      "half_difference_semantics": "Subtract the complete afternoon signed-return correlation from the complete morning signed-return correlation exactly once.",
