    "formula_steps": [
      "Use the 240 close, normalized-share-volume, and CNY-amount observations at 09:31-11:30 and 13:01-15:00; preserve but exclude the standalone 09:30 source row.",
      "Require every close to be finite and strictly positive and every volume and amount to be finite and nonnegative.",
      "Treat a bar with volume=0 and amount=0 as inactive with zero weight. If exactly one of volume or amount is zero, the stock-day is invalid; do not repair the pair.",
      "For each active bar compute bar_vwap=amount/volume and gap=log(close/bar_vwap); require both values to be finite and bar_vwap strictly positive.",
      "Compute Sum(amount*gap)/Sum(amount) over active bars and require a finite strictly positive amount denominator.",
      "Do not impose a minimum active-bar count, clip, winsorize, impute, rank-transform, substitute another weight, or use source open/high/low or any daily value."
    ],
    "formula": "Sum(amount_t * log(close_t / (amount_t / volume_t))) / Sum(amount_t) over active bars t at 09:31-11:30 and 13:01-15:00",
    "validity": {
      "all_240_continuous_closes_finite_and_strictly_positive": true,
      "all_240_continuous_volumes_and_amounts_finite_and_nonnegative": true,
      "zero_volume_zero_amount_bar_policy": "inactive_zero_weight",
      "one_sided_zero_activity_pair_policy": "stock_day_missing",
      "finite_strictly_positive_bar_vwap_required_for_active_bars": true,
      "finite_strictly_positive_total_active_amount_required": true,
      "finite_weighted_log_gap_required": true,
      "theoretical_range": "unbounded_real",
      "minimum_active_bar_count": null,
      "statistical_clipping_imputation_winsorization_rank_transform_weight_substitution_or_daily_substitution_allowed": false
    },
    "hypothesis": "A high value means active minutes repeatedly ended above their own executed average transaction prices after CNY-amount weighting, consistent with buyer urgency that may persist from the next open through the third close.",
    "economic_distinction": "This full-session factor references each close to its same-minute transaction VWAP. It is neither a previous-close return, a final-window VWAP-to-day-VWAP level, total volatility, return distribution, amount timing, nor amount-return correlation. It is scale-free in absolute price and total amount while retaining signed within-bar execution pressure.",
