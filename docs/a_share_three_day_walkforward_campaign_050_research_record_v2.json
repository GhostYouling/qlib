    ],
    "include_0930": false,
    "include_lunch_transition": false,
    "close_semantics": "Every selected close must be finite and strictly positive; compute only within-half adjacent natural-log returns and retain exact zero nonselected returns.",
    "absolute_shock_tie_rule": "Choose the earliest index attaining the maximum absolute log return separately within each half-session.",
    "terminal_retracement_rule": "For each selected return s ending at close c, compute R=log(final_close_of_same_half/c); the selected return itself is not repeated in R.",
    "half_score_rule": "h=-2*s*R/(s^2+R^2); require finite strictly positive denominator. A zero terminal retracement is valid and scores zero.",
    "aggregation_rule": "Arithmetic mean of the valid morning and afternoon half scores with fixed weights 0.5 and 0.5.",
