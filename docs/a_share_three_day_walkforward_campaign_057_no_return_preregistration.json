    "name": "intraday_day_over_day_absolute_return_profile_similarity_238b",
    "direction": "higher",
    "formula": "For signal session t and accepted market session t-1, form the exact 238 fixed within-half absolute log-close returns for each session, normalize both magnitude vectors independently to p and q, compute equal-mixture natural-log Jensen-Shannon divergence JSD(p,q), and return 1-JSD/ln(2).",
    "economic_hypothesis": "Repeated normalized volatility scheduling across consecutive sessions may represent persistent information-release or execution timing rather than a one-day shock and may remain informative through the third close.",
    "source_projection": [
      "datetime",
      "symbol",
      "provider",
      "close"
    ],
    "forbidden_source_columns": [
      "open",
      "high",
      "low",
      "volume",
      "amount"
    ],
    "accepted_minute_grid": "09:31--11:30 and 13:01--15:00 exactly 240 closes on each of two sessions; source 09:30 rows and the lunch transition are excluded",
    "current_session": "signal session t",
    "prior_session": "exactly the immediately preceding accepted local market-calendar session t-1",
    "bridge_missing_or_suspended_prior_stock_session": false,
    "selected_close_count_per_session": 240,
    "absolute_return_bin_count_per_session": 238,
    "return_rule": "119 adjacent natural-log close returns inside each 120-close half; take absolute magnitude after return construction; exact-zero returns remain at fixed bins",
    "session_normalization": "divide every absolute return by that session's strictly positive total absolute return",
    "mixture_rule": "m_i=(p_i+q_i)/2 with equal session weights",
    "divergence_rule": "0.5*sum over positive p_i of p_i*ln(p_i/m_i) plus 0.5*sum over positive q_i of q_i*ln(q_i/m_i); zero terms contribute zero",
    "score_rule": "1-JSD/ln(2)",
    "missing_rule": "Missing unless both calendar-adjacent exact 240-close grids exist inside the bound source interval, all selected closes are finite and positive, and both 238-bin total absolute returns are strictly positive. Never bridge, fill, repair, clip, winsorize, or substitute.",
