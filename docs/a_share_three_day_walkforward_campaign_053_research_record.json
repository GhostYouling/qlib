    ],
    "accepted_minute_grid": "09:31--11:30 and 13:01--15:00 exactly 240 bars; source 09:30 identity row is excluded",
    "return_pair_rule": "119 adjacent log-close returns independently within each half; no 09:30 return and no lunch transition",
    "amount_alignment": "nonnegative amount at each return endpoint, exactly 238 values",
    "missing_rule": "Require all 240 closes finite and strictly positive, all 238 endpoint amounts finite and nonnegative, positive total endpoint amount, and positive total absolute within-half return; otherwise missing.",
    "zero_contribution_rule": "For KL terms, 0*ln(0/m) is exactly zero; m is positive wherever either distribution has positive mass.",
    "normalization": "one minus Jensen-Shannon divergence divided by natural-log two",
    "valid_range": {
