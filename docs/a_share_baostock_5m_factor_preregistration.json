  "features": [
    {
      "name": "late_return_30m_5m",
      "formula": "close at 15:00 / close at 14:30 - 1",
      "diagnostic_direction": "higher",
      "hypothesis": "Positive last-30-minute price pressure persists into the next three sessions."
    },
    {
      "name": "late_amount_share_30m_5m",
      "formula": "sum amount for the six bar ends after 14:30 / full-session sum amount",
      "diagnostic_direction": "higher",
      "hypothesis": "A larger late-session transaction share identifies concentrated closing demand."
    },
    {
      "name": "late_vwap_to_day_vwap_30m_5m",
      "formula": "late-30-minute amount/volume divided by full-session amount/volume minus 1",
      "diagnostic_direction": "higher",
      "hypothesis": "Late trading above the full-session VWAP identifies persistent demand."
    },
    {
      "name": "opening_gap_digestion_5m",
      "formula": "-sign(open / previous comparable raw close - 1) * (close / open - 1)",
      "diagnostic_direction": "higher",
      "hypothesis": "A session that digests its opening gap toward the prior comparable close is more resilient."
    },
    {
      "name": "intraday_realized_volatility_5m",
      "formula": "sqrt(sum of squared log returns across the 47 consecutive five-minute closes)",
      "diagnostic_direction": "lower",
      "hypothesis": "Lower complete-session five-minute path volatility is associated with a better next-three-session return."
    }
  ],
