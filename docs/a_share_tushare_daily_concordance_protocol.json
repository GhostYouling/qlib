    "documented_maximum_rows_per_call": 6000,
    "reaching_maximum_rows_policy": "reject_as_possible_truncation",
    "minimum_seconds_between_calls": 0.18,
    "maximum_planned_calls_per_minute": 333,
    "transient_attempts_per_session": 3,
