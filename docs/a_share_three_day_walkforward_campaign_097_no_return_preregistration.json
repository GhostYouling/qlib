  "candidate": {
    "name": "intraday_market_range_profile_synchronization_240m",
    "direction": "higher",
    "economic_hypothesis": "A stock whose fixed-clock intraday range allocation is aligned with the contemporaneous leave-one-out market may reflect broad liquid information arrival rather than isolated stress, and that synchronized state may persist over three accepted sessions.",
    "formula": "For every selected bar set q_i=log(high_i/low_i), require positive Q=sum(q), and set p_i=q_i/Q. For each date subtract p from the complete-profile market sum, divide by the leave-one-out peer count to obtain m, and return population PearsonCorr(p,m) across exactly 240 aligned clock positions.",
