      "datetime",
      "symbol",
      "provider",
      "high",
      "low"
    ],
    "forbidden_source_columns": [
      "open",
      "close",
      "volume",
      "amount"
    ],
    "accepted_minute_grid": "09:31--11:30 and 13:01--15:00 exactly 240 high/low bars; standalone 09:30 and the lunch transition are excluded",
    "selected_bar_count": 240,
    "range_rule": "Require finite low>0 and finite high>=low at every selected bar; x=ln(high/low), and exact high=low gives retained x=0.",
    "triple_rule": "118 overlapping consecutive triples per 120-bar half, pooled into exactly 236 equal-weight triples with no lunch-spanning triple.",
    "weak_order_key": "(cmp(x0,x1),cmp(x0,x2),cmp(x1,x2)) with cmp in {-1,0,+1} and zero tolerance",
    "weak_order_state_count": 13,
    "exact_ties_retained": true,
    "time_reversal_rule": "R maps the state of (x0,x1,x2) to the state of (x2,x1,x0); q_s=p_R(s), and R is a fixed involution.",
    "divergence_rule": "With m_s=(p_s+q_s)/2, use [0.5*sum_{p_s>0}p_s*ln(p_s/m_s)+0.5*sum_{q_s>0}q_s*ln(q_s/m_s)]/ln(2).",
    "zero_semantics": "A reversal-invariant state distribution, including an all-tied path, has a valid score of zero; no pseudocount, smoothing, tie deletion, or jitter is used.",
    "endpoint_canonicalization_tolerance": 1e-12,
    "valid_range": {
      "lower": 0.0,
      "lower_inclusive": true,
      "upper": 1.0,
      "upper_inclusive": true
    },
    "missing_rule": "Missing unless the exact 240-bar grid and exactly 236 recognized transitive state keys exist and all high, low, ranges, frequencies, divergence components, and final score are finite and valid. Never fill, jitter, tolerance-match, drop, smooth, clip, winsorize, threshold, filter, or substitute.",
