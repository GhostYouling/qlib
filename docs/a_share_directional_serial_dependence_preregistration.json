    "name": "directional_serial_dependence_20",
    "formula": "Sign($close/Ref($close, 1) - 1)*(Corr($close/Ref($close, 1) - 1, Ref($close/Ref($close, 1) - 1, 1), 20) + 0*Ref($close, 21))",
    "diagnostic_direction": "higher",
    "required_complete_return_pairs": 20,
    "required_prior_close_sessions": 21,
    "interpretation": {
      "positive_current_return_and_positive_autocorrelation": "upward continuation",
      "negative_current_return_and_negative_autocorrelation": "downward move expected to reverse",
      "zero_current_return": "zero raw score before cross-sectional ranking"
    },
    "distinct_from_existing_fields": [
      "momentum measures cumulative direction but not serial dependence",
      "signed_efficiency measures endpoint movement relative to path length but not lag-one dependence",
      "return-turnover correlation measures participation rather than price-path dependence",
