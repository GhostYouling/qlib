  "factors": [
    {
      "name": "late_return_30m",
      "formula": "close_at_15_00 / close_at_14_30 - 1 after bar-end normalization",
      "diagnostic_direction": "higher",
      "hypothesis": "A price move supported through the final thirty minutes persists over the next three sessions."
    },
    {
      "name": "late_amount_share_30m",
      "formula": "amount_over_bar_ends_14_31_through_15_00 / full_session_amount",
      "diagnostic_direction": "higher",
      "hypothesis": "Unusually late trading participation indicates demand that is not fully resolved by the close."
    },
    {
      "name": "late_vwap_to_day_vwap_30m",
      "formula": "late_30m_vwap / full_session_vwap - 1",
      "diagnostic_direction": "higher",
      "hypothesis": "Late trading above the full-session paid-price center indicates persistent closing demand."
    },
    {
      "name": "intraday_realized_volatility",
      "formula": "sqrt(sum(square(diff(log(minute_close))))) over the canonical complete regular session",
      "diagnostic_direction": "lower",
      "hypothesis": "Lower intraday path volatility reduces short-horizon tail risk for otherwise eligible stocks."
    }
  ],
