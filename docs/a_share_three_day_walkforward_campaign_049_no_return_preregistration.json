  "candidate": {
    "name": "intraday_morning_afternoon_amount_profile_similarity_120b",
    "direction": "higher",
    "formula": "Use exactly 120 morning amounts and 120 afternoon amounts. Normalize each half independently to p_i=a_morning_i/sum(a_morning) and q_i=a_afternoon_i/sum(a_afternoon). With m_i=(p_i+q_i)/2, return 1-[0.5*sum(p_i*log(p_i/m_i))+0.5*sum(q_i*log(q_i/m_i))]/log(2), using 0*log(0/m)=0.",
    "economic_hypothesis": "A repeatable within-stock liquidity clock across the two continuous half sessions is consistent with stable participation and execution capacity rather than one-off activity bursts, potentially leaving a more resilient completed-session state for the next-open-to-third-close horizon.",
