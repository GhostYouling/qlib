    "raw_column": "securities_lending_net_cover_ratio",
    "direction": "higher_net_cover_ratio_is_better",
    "score_formula_if_capacity_passes": "cross_sectional_percentile_rank(securities_lending_net_cover_ratio)",
    "maximum_event_age_days": 0,
    "mechanism": "More securities returned relative to new short sales may indicate short covering and less incremental short pressure before the following session."
