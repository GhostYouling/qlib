      "securities_lending_repay_shares",
      "securities_lending_net_cover_ratio"
    ],
    "event_key": [
      "instrument",
      "trade_date"
    ],
    "factor_formula": "(RQCHL - RQMCL) / (RQCHL + RQMCL)",
    "zero_activity_policy": "Rows with RQMCL + RQCHL equal to zero remain missing and are excluded from the event snapshot; zero balance is otherwise valid.",
