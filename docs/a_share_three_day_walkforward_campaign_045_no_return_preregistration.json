    "include_0930": false,
    "include_lunch_transition": false,
    "within_half_return_count": 238,
    "adjacent_pair_count": 236,
    "return_definition": "r_j=log(close_{j+1}/close_j) separately inside each 120-close half",
    "activity_definition": "a_j=log1p(destination_bar_amount_cny) for each within-half return",
    "reactive_component": "population PearsonCorr(abs(r_j),a_{j+1}) over the pooled 236 within-half adjacent pairs",
    "anticipatory_component": "population PearsonCorr(a_j,abs(r_{j+1})) over the same pooled 236 within-half adjacent pairs",
    "score_definition": "reactive_component_minus_anticipatory_component",
    "zero_semantics": "Retain every exact-zero return and exact-zero amount at its fixed position.",
    "variance_semantics": "Require strictly positive population variance in both vectors of each Pearson component.",
    "endpoint_canonicalization_tolerance": 1e-12,
